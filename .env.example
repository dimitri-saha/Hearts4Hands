# Hearts4Hands — environment variables
# Copy to .env.local for local dev. Nothing here is required to run `npm run dev`;
# the site degrades gracefully when values are missing (see CLAUDE.md §3).

# --- Site ---------------------------------------------------------------------
# Used for canonical URLs, the sitemap, and social cards.
NEXT_PUBLIC_SITE_URL=https://hearts4hands.org

# --- Supabase -----------------------------------------------------------------
# Project settings -> API. The service-role key must NEVER be prefixed with
# NEXT_PUBLIC_ and must never be committed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Donation links -----------------------------------------------------------
# Any channel left blank is hidden on the Donate page.
NEXT_PUBLIC_GOFUNDME_URL=
NEXT_PUBLIC_VENMO_URL=
NEXT_PUBLIC_VENMO_HANDLE=@Hearts4Hands
NEXT_PUBLIC_PAYPAL_URL=

# --- Contact ------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=hello@hearts4hands.org
NEXT_PUBLIC_EDITOR_EMAIL=stories@hearts4hands.org
NEXT_PUBLIC_PARTNERSHIPS_EMAIL=partners@hearts4hands.org
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/hearts4hands

# --- Email (optional) ---------------------------------------------------------
# Without these, submissions still save — they just don't send confirmations.
RESEND_API_KEY=
RESEND_FROM=Hearts4Hands <hello@hearts4hands.org>
NOTIFY_EMAIL=hello@hearts4hands.org
